# EventNexus Hanke Keskond API Configuration
# Copy this file to .env and fill in real values.
# Never commit the real .env file — it contains secrets.

# --- Application ---
# APP_ENV: "development" | "production" | "testing"
APP_ENV=development

# APP_NAME: Application name shown in OpenAPI docs and logs
APP_NAME=EventNexus Hanke Keskond

# APP_VERSION: Application version (informational)
APP_VERSION=0.1.0

# DEBUG: Enable FastAPI debug mode (MUST be false in production)
DEBUG=false

# --- Server ---
# API_HOST: Bind address for the API server
API_HOST=0.0.0.0

# API_PORT: Port for the API server
API_PORT=8000

# --- Security ---
# SECRET_KEY: Secret key for session/token signing.
# In production, set to a randomly generated string of at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ALLOWED_HOSTS: JSON array of trusted host allowlist
ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]

# CORS_ORIGINS: JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# CORS_METHODS: JSON array of allowed HTTP methods
CORS_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]

# CORS_HEADERS: JSON array of allowed request headers
CORS_HEADERS=["Authorization","Content-Type","X-Requested-With"]

# --- Logging ---
# LOG_LEVEL: "DEBUG" | "INFO" | "WARNING" | "ERROR" | "CRITICAL"
LOG_LEVEL=info

# LOG_FORMAT: "json" for production, "console" for development
LOG_FORMAT=console

# --- Database (planned for S2) ---
DATABASE_URL=postgresql+asyncpg://eventnexus:password@db:5432/eventnexus
