APP_NAME=EventNexus Hanke Keskond Worker
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false

WORKER_REDIS_HOST=redis
WORKER_REDIS_PORT=6379
WORKER_REDIS_DB=0
WORKER_REDIS_PASSWORD=

WORKER_THREADS=4
WORKER_PROCESSES=1
WORKER_QUEUES=default,high,low

WORKER_TASK_TIMEOUT=60000
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY=5000
WORKER_DEAD_LETTER_QUEUE=dead_letter

WORKER_HEALTH_PORT=8001

LOG_LEVEL=info
LOG_FORMAT=json
